# ==========================================
# 1. Environment & API Secrets (CRITICAL)
# ==========================================
.env
.env.*
*.env
!.env.example

# ==========================================
# 2. Virtual Environments
# ==========================================
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 3. Python Compiled / Cache Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 4. Large Datasets & Media (NetCDF / Audio)
# ==========================================
# Heavy NetCDF oceanographic files in /data
data/*.nc
*.nc

# Audio recordings / temporary voice payloads
*.wav
*.mp3
*.m4a
*.ogg

# ==========================================
# 5. Local Vector Databases & Analytics DBs
# ==========================================
# ChromaDB persistence folder in core_db
core_db/chroma_db/
chroma_db/
*.chroma

# Local DuckDB databases & logs
*.duckdb
*.duckdb.wal

# ==========================================
# 6. IDEs & OS System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# 7. Streamlit & Testing Logs
# ==========================================
.streamlit/secrets.toml
.pytest_cache/